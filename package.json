{
  "name": "z8-card-flow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Z8 API backend with Firebase Authentication and PostgreSQL",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node scripts/migrate.mjs && nest start",
    "start:dev": "node scripts/migrate.mjs && nest start",
    "start:prod": "node scripts/migrate.mjs && node dist/main.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:audit": "node scripts/audit-local.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "db:sync-roles": "node scripts/sync-admin-roles.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  }
}
