NODE_ENV=development
PORT=3001
API_HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:3001/v1
# Comma-separated CIDRs for reverse proxies that set X-Forwarded-For; leave blank unless known.
TRUSTED_PROXY_CIDRS=
POSTGRES_DB=z8_portal
POSTGRES_USER=z8_app
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=54329
DATABASE_URL=postgresql://z8_app:<url-encoded-password>@localhost:54329/z8_portal
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_GOOGLE_SERVER_CLIENT_ID=replace-with-the-Web-OAuth-client-ID
FIREBASE_GOOGLE_ANDROID_CLIENT_ID=replace-with-the-Android-OAuth-client-ID
FIREBASE_GOOGLE_IOS_CLIENT_ID=replace-with-the-iOS-OAuth-client-ID
ADMIN_SEED_EMAIL=uaebenflis@gmail.com
# Optional local-only password for db:seed:admin; prefer a masked prompt.
Z8_ADMIN_SEED_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_PEPPER=
PASSWORD_RESET_URL=https://portal.z8card.com/reset-password
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://portal.z8card.com
# All retained uploads use private S3 storage. The SDK reads credentials from an
# AWS IAM role in production or a local AWS CLI profile during development.
PRIVATE_FILES_STORAGE=s3
AWS_REGION=eu-north-1
S3_BUCKET=replace-with-your-created-bucket-name
# Only used when PRIVATE_FILES_STORAGE=local.
PRIVATE_FILES_PATH=./storage/private
# Generate independent random encryption and signing keys; keep them stable for stored files and links.
PRIVATE_FILE_ENCRYPTION_KEY=
PRIVATE_FILE_SIGNING_KEY=
# Generate a separate stable base64-encoded 32-byte key for sensitive record fields.
RECORD_PII_ENCRYPTION_KEY=
# Generate a different, stable base64-encoded 32-byte key for owner email lookups.
RECORD_LOOKUP_HMAC_KEY=

# PhotonPay credentials: keep values server-side in this file only.
# PHOTONPAY_ENV must be sandbox or prod. Start with sandbox.
PHOTONPAY_ENV=sandbox
# Mirrors the legacy daily transaction back-fill workflow (02:17 UTC).
PHOTONPAY_DAILY_SYNC_ENABLED=true
PHOTONPAY_APP_ID=
PHOTONPAY_APP_SECRET=
PHOTONPAY_TOKEN_ENCRYPTION_KEY=
PHOTONPAY_RSA_PRIVATE_KEY=
# Or point to a local PEM file that stays ignored by git.
PHOTONPAY_RSA_PRIVATE_KEY_PATH=
PHOTONPAY_PUBLIC_KEY=
PHOTONPAY_MASTER_ACCOUNT_EMAIL=

# Optional: only needed if PhotonPay requires a fixed outbound IP.
PHOTONPAY_RELAY_URL=
PHOTONPAY_RELAY_SECRET=

# Optional diagnostic comparison key used by the existing web implementation.
MERCHANT_PUBLIC_KEY=

# Optional GPT-6 Astra assistant. Conversations are stored in PostgreSQL.
GPT_AI_API_KEY=
GPT_AI_MODEL=gpt-6-astra
GPT_AI_REASONING_EFFORT=medium
# Local option A (recommended for development): set this to a Firebase Admin SDK
# service-account JSON file stored outside this repository. Never commit that file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/.config/z8/firebase-admin.json
# Option B: use Google Application Default Credentials from your local gcloud setup.
